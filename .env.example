# Copie para .env somente quando precisar sobrescrever os padrões locais.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3333
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3333

# PostgreSQL. Necessária para executar a API fora do ambiente de testes.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iwantit

# Token de uma aplicação autorizada no Mercado Livre. Sem ele, o provider informa indisponibilidade.
MERCADO_LIVRE_ACCESS_TOKEN=

# Monitor periódico. Mantenha desabilitado em processos que não devem executar jobs.
MONITORING_ENABLED=false
MONITORING_INTERVAL_MINUTES=30
MONITORING_BATCH_SIZE=50

# URLs e sessão
PASSWORD_RESET_URL=http://localhost:5173/redefinir-senha
SESSION_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
TWO_FACTOR_CHALLENGE_TTL_MINUTES=5
MAX_ACTIVE_SESSIONS=10

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Obrigatória e com exatamente 32 bytes em produção.
TWO_FACTOR_ENCRYPTION_KEY=

# Google Cloud Console → OAuth 2.0 Client ID do tipo "Aplicativo da Web"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/api/auth/google/callback
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:5173/app
GOOGLE_OAUTH_ERROR_URL=http://localhost:5173/entrar

# SMTP é obrigatório em produção. Em desenvolvimento, o link é exibido no log da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=I Want It <no-reply@example.com>

# Produção com docker-compose.production.yml
# PUBLIC_WEB_ORIGIN deve ser a origem HTTPS pública, sem barra final.
PUBLIC_WEB_ORIGIN=https://wishlist.example.com
WEB_PORT=8080
POSTGRES_DB=iwantit
POSTGRES_USER=iwantit
POSTGRES_PASSWORD=
# No Compose de produção, use host "postgres" e escape caracteres especiais da senha na URL.
# DATABASE_URL=postgresql://iwantit:senha-escapada@postgres:5432/iwantit
